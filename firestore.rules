rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function user(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function pairMember(pairId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.memberUids;
    }

    match /users/{uid} {
      allow create: if owner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower is string;
      // Authenticated users can read basic profiles for partner search and pairing.
      allow read: if signedIn();
      // Owner has full update rights. Connected partner in an atomic transaction
      // can only update activePairId and updatedAt when forming or leaving a pair.
      allow update: if owner(uid)
        || (signedIn()
          && request.resource.data.activePairId is string
          && request.auth.uid in getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.activePairId)).data.memberUids
          && uid in getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.activePairId)).data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activePairId', 'updatedAt']));
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /connectionRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    match /pairingCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && (resource.data.uid == request.auth.uid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'usedByUid'])
              && request.resource.data.usedByUid == request.auth.uid
              && request.resource.data.status == 'used'));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /pairs/{pairId} {
      allow read: if pairMember(pairId);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2;
      allow update: if pairMember(pairId);

      match /moments/{momentId} {
        allow read: if pairMember(pairId);
        allow create: if pairMember(pairId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.status in ['uploading', 'ready', 'failed'];
        allow update: if pairMember(pairId)
          && resource.data.senderUid == request.auth.uid;
        allow delete: if pairMember(pairId)
          && resource.data.senderUid == request.auth.uid;
      }

      match /moods/{uid} {
        allow read: if pairMember(pairId);
        allow create, update: if pairMember(pairId)
          && owner(uid)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if pairMember(pairId) && owner(uid);
      }

      match /messages/{messageId} {
        allow read: if pairMember(pairId);
        allow create: if pairMember(pairId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false; // Private messages are immutable
        allow delete: if pairMember(pairId)
          && resource.data.senderUid == request.auth.uid;
      }
    }

    match /users/{uid}/devices/{deviceId} {
      allow read, write: if owner(uid);
    }
  }
}
